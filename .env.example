# Local-only Airlytics configuration. No cloud credentials required.
STREAMING_SINK=kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC=raw-flight-pings
KAFKA_DEADLETTER_TOPIC=deadletter-pings
KAFKA_SNAPSHOT_EVENTS_TOPIC=aircraft-observation-events
SNAPSHOT_STATE_DB=data/state/aircraft_state.sqlite
SNAPSHOT_MISSING_THRESHOLD=3
POLL_INTERVAL_SECONDS=10
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
BACKOFF_FACTOR=2
PARQUET_PATH=data/bronze/flight-legs
CHECKPOINT_DIR=data/checkpoints/flight-legs
